// Pipeline DEV: build + test + deploy a circleguard-dev y promueve a stage.
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
    timeout(time: 30, unit: 'MINUTES')
  }

  triggers {
    pollSCM('* * * * *')
  }

  environment {
    IMAGE_TAG    = 'dev'
    K8S_NS       = 'circleguard-dev'
    KUBECONFIG   = '/var/jenkins_home/.kube/config'
    GIT_REPO_URL = 'github.com/Santiago-Cardenas/circle-guard-public.git'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty=oneline'
      }
    }

    stage('Toolchain check') {
      steps {
        sh '''
          set -e
          echo "--- docker ---";    docker version --format '{{.Client.Version}}'
          echo "--- kubectl ---";   kubectl version --client=true -o yaml | head -n 5
          echo "--- cluster ---";   kubectl get nodes
        '''
      }
    }

    stage('Tests & Build') {
      steps {
        sh '''
          set -e
          chmod +x ./gradlew
          ./gradlew test bootJar -x :tests:e2e:test --no-daemon --console=plain --warning-mode=none
          find services -path '*/build/libs/*.jar' ! -name '*-plain.jar' -printf '%p (%s bytes)\\n'
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
        }
      }
    }

    stage('Analisis de calidad (SonarQube)') {
      steps {
        // El token de Sonar se guarda como credencial secreta en Jenkins.
        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
          sh '''
            set -e
            ./gradlew sonar \
              -Dsonar.projectKey=circleguard \
              -Dsonar.projectName=CircleGuard \
              -Dsonar.host.url=http://host.docker.internal:9000 \
              -Dsonar.token=${SONAR_TOKEN} \
              --no-daemon --console=plain --warning-mode=none
          '''
        }
      }
    }

    stage('Build images') {
      steps {
        sh '''
          set -e
          chmod +x infra/docker/build-all.sh
          TAG=${IMAGE_TAG} bash infra/docker/build-all.sh
        '''
      }
    }

    stage('Escaneo de imagenes (Trivy)') {
      steps {
        // Trivy revisa las imagenes en busca de vulnerabilidades conocidas.
        // Si encuentra HIGH o CRITICAL marca el build como inestable (no lo rompe).
        sh '''
          set +e
          mkdir -p build/security
          STATUS=0
          for s in auth identity gateway promotion notification dashboard; do
            echo "== Escaneando circleguard/${s}:${IMAGE_TAG} =="
            docker run --rm \
              -v /var/run/docker.sock:/var/run/docker.sock \
              -v trivy-cache:/root/.cache/ \
              aquasec/trivy:latest image \
                --severity HIGH,CRITICAL \
                --exit-code 1 \
                --no-progress \
                circleguard/${s}:${IMAGE_TAG} | tee build/security/trivy-${s}.txt
            if [ "${PIPESTATUS:-$?}" != "0" ]; then STATUS=1; fi
          done
          if [ "${STATUS}" = "1" ]; then
            echo "Trivy encontro vulnerabilidades HIGH/CRITICAL."
            exit 1
          fi
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'build/security/*', fingerprint: true, allowEmptyArchive: true
        }
        failure {
          echo 'Hay vulnerabilidades en las imagenes; revisar reportes de Trivy.'
        }
      }
    }

    stage('Deploy to circleguard-dev') {
      steps {
        sh '''
          set -e
          kubectl apply -f infra/k8s/namespaces.yaml
          # Aumentar cuota de memoria para acomodar todos los pods con sus limites explicitos.
          # Terraform fijo 8Gi pero el LimitRange aplica 512Mi por defecto a pods sin limites,
          # y los pods de BD mas los 6 servicios de app superan 8Gi en ciertas versiones.
          kubectl -n ${K8S_NS} patch resourcequota cuota-dev \
            --type=merge \
            -p '{"spec":{"hard":{"limits.memory":"16Gi","limits.cpu":"8","requests.memory":"8Gi","requests.cpu":"4"}}}' \
            2>/dev/null || true
          kubectl apply -k infra/k8s/dev
          # Servicios de app: rollout rapido
          kubectl -n ${K8S_NS} rollout status deployment/gateway deployment/auth deployment/identity deployment/dashboard deployment/promotion deployment/notification --timeout=240s
          # Infraestructura (BD, Kafka, Zookeeper): mas lento con sidecars Istio
          kubectl -n ${K8S_NS} rollout status deployment/postgres deployment/redis deployment/neo4j deployment/zookeeper deployment/kafka deployment/openldap deployment/mailhog --timeout=480s
        '''
      }
    }

    stage('Apply security manifests (dev)') {
      steps {
        sh '''
          set -e
          kubectl apply -k infra/k8s/security -n ${K8S_NS}
        '''
      }
    }

    stage('Apply Istio policies (dev)') {
      steps {
        sh '''
          # Solo aplica si Istio esta instalado (CRDs presentes).
          if kubectl get crd virtualservices.networking.istio.io >/dev/null 2>&1; then
            echo "Istio detectado — aplicando politicas de trafico y mTLS..."
            kubectl apply -f infra/k8s/istio/01-mtls-peer-auth.yaml
            kubectl apply -f infra/k8s/istio/02-virtual-services.yaml
            kubectl apply -f infra/k8s/istio/03-destination-rules.yaml
          else
            echo "Istio no instalado — saltando etapa. Ejecuta infra/k8s/istio/00-install-istio.sh para instalarlo."
          fi
        '''
      }
    }

    stage('Chaos Engineering') {
      steps {
        sh '''
          # Solo ejecuta si Chaos Mesh esta instalado en el cluster.
          if kubectl get namespace chaos-testing >/dev/null 2>&1; then
            echo "Chaos Mesh detectado — ejecutando experimentos de caos en ${K8S_NS}..."
            kubectl apply -f infra/k8s/chaos/01-pod-kill-gateway.yaml -n ${K8S_NS}
            kubectl apply -f infra/k8s/chaos/02-network-delay-identity.yaml -n ${K8S_NS}
            echo "Experimentos activos. Esperando 10s para observar estado post-caos..."
            sleep 10
            echo "=== Estado pods post-caos ==="
            kubectl get pods -n ${K8S_NS}
            echo "=== Limpiando experimentos ==="
            kubectl delete -f infra/k8s/chaos/01-pod-kill-gateway.yaml -n ${K8S_NS} --wait=false 2>/dev/null || true
            kubectl delete -f infra/k8s/chaos/02-network-delay-identity.yaml -n ${K8S_NS} --wait=false 2>/dev/null || true
            echo "Chaos Engineering completado."
          else
            echo "Chaos Mesh no instalado — saltando. Ejecuta infra/k8s/chaos/00-install-chaos-mesh.sh para activarlo."
          fi
        '''
      }
    }

    stage('Auto-promote dev -> stage') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-pat',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set -e
            git config user.email "jenkins@circleguard.local"
            git config user.name  "Jenkins CI"
            REMOTE_URL="https://${GH_USER}:${GH_TOKEN}@${GIT_REPO_URL}"
            DEV_SHA=${GIT_COMMIT}
            git reset --hard ${DEV_SHA}
            git clean -fd
            git fetch ${REMOTE_URL} stage
            git branch -D stage_local 2>/dev/null || true
            git checkout -b stage_local FETCH_HEAD
            git merge --no-ff -X theirs ${DEV_SHA} -m "auto-promote(ci): dev -> stage (build #${BUILD_NUMBER})"
            git push ${REMOTE_URL} stage_local:stage
          '''
        }
      }
    }
  }

  post {
    always {
      // Escala dev a 0 para liberar RAM antes de que arranque el pipeline de stage.
      sh 'kubectl -n ${K8S_NS} scale deployment --all --replicas=0 2>/dev/null || true'
    }
    success {
      echo "Pipeline DEV OK — imágenes :${IMAGE_TAG} desplegadas en ${K8S_NS}"
    }
    failure {
      sh 'kubectl -n ${K8S_NS} get pods || true'
      sh 'kubectl -n ${K8S_NS} get events --sort-by=.lastTimestamp | tail -n 30 || true'
      sh 'bash pipelines/notify.sh "FALLO pipeline DEV #${BUILD_NUMBER}" "El build fallo. Revisa: ${BUILD_URL}" || true'
    }
  }
}
