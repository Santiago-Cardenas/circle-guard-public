// Pipeline DEV: build + test + deploy a circleguard-dev y promueve a stage.
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
    timeout(time: 30, unit: 'MINUTES')
  }

  triggers {
    pollSCM('* * * * *')
  }

  environment {
    IMAGE_TAG    = 'dev'
    K8S_NS       = 'circleguard-dev'
    KUBECONFIG   = '/var/jenkins_home/.kube/config'
    GIT_REPO_URL = 'github.com/Santiago-Cardenas/circle-guard-public.git'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty=oneline'
      }
    }

    stage('Toolchain check') {
      steps {
        sh '''
          set -e
          echo "--- docker ---";    docker version --format '{{.Client.Version}}'
          echo "--- kubectl ---";   kubectl version --client=true -o yaml | head -n 5
          echo "--- cluster ---";   kubectl get nodes
        '''
      }
    }

    stage('Tests & Build') {
      steps {
        sh '''
          set -e
          chmod +x ./gradlew
          ./gradlew test bootJar -x :tests:e2e:test --no-daemon --console=plain
          find services -path '*/build/libs/*.jar' ! -name '*-plain.jar' -printf '%p (%s bytes)\\n'
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
        }
      }
    }

    stage('Build images') {
      steps {
        sh '''
          set -e
          chmod +x infra/docker/build-all.sh
          TAG=${IMAGE_TAG} bash infra/docker/build-all.sh
        '''
      }
    }

    stage('Deploy to circleguard-dev') {
      steps {
        sh '''
          set -e
          kubectl apply -f infra/k8s/namespaces.yaml
          kubectl apply -k infra/k8s/dev
          kubectl -n ${K8S_NS} rollout restart deployment
          kubectl -n ${K8S_NS} rollout status deployment --timeout=240s
        '''
      }
    }

    stage('Auto-promote dev -> stage') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-pat',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set -e
            git config user.email "jenkins@circleguard.local"
            git config user.name  "Jenkins CI"
            REMOTE_URL="https://${GH_USER}:${GH_TOKEN}@${GIT_REPO_URL}"
            DEV_SHA=${GIT_COMMIT}
            git reset --hard ${DEV_SHA}
            git clean -fd
            git fetch ${REMOTE_URL} stage
            git branch -D stage_local 2>/dev/null || true
            git checkout -b stage_local FETCH_HEAD
            git merge --no-ff -X theirs ${DEV_SHA} -m "auto-promote(ci): dev -> stage (build #${BUILD_NUMBER})"
            git push ${REMOTE_URL} stage_local:stage
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Pipeline DEV OK — imágenes :${IMAGE_TAG} desplegadas en ${K8S_NS}"
    }
    failure {
      sh 'kubectl -n ${K8S_NS} get pods || true'
      sh 'kubectl -n ${K8S_NS} get events --sort-by=.lastTimestamp | tail -n 30 || true'
    }
  }
}
