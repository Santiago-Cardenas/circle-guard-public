// Pipeline MASTER: build + test + deploy a circleguard-prod, corre E2E,
// genera release notes y publica un GitHub Release con tag semantico vX.Y.Z.
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
    timeout(time: 45, unit: 'MINUTES')
  }

  triggers {
    pollSCM('* * * * *')
  }

  environment {
    IMAGE_TAG     = 'prod'
    K8S_NS        = 'circleguard-prod'
    KUBECONFIG    = '/var/jenkins_home/.kube/config'
    GATEWAY_URL   = 'http://host.docker.internal:32087'
    AUTH_URL      = 'http://host.docker.internal:32180'
    DASHBOARD_URL = 'http://host.docker.internal:32084'
    GIT_REPO_URL  = 'github.com/Santiago-Cardenas/circle-guard-public.git'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty=oneline'
      }
    }

    stage('Toolchain check') {
      steps {
        sh '''
          set -e
          echo "--- docker ---";    docker version --format '{{.Client.Version}}'
          echo "--- kubectl ---";   kubectl version --client=true -o yaml | head -n 5
          echo "--- cluster ---";   kubectl get nodes
        '''
      }
    }

    stage('Verify stage health') {
      steps {
        sh '''
          set -e
          # Consulta la Jenkins API para conocer el ultimo resultado del pipeline de stage.
          # Si la API no responde (auth/red), continua de todas formas: la garantia real
          # es el mecanismo de auto-promote — stage solo pushea a master si termina en SUCCESS.
          STAGE_STATUS="UNKNOWN"
          API_RESPONSE=$(curl -s --max-time 10 \
            "http://host.docker.internal:8080/job/circleguard-stage/lastBuild/api/json" 2>/dev/null || true)
          if [ -n "${API_RESPONSE}" ]; then
            STAGE_STATUS=$(echo "${API_RESPONSE}" | \
              python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('result') or 'IN_PROGRESS')" \
              2>/dev/null || echo "UNKNOWN")
          fi
          echo "Ultimo resultado del pipeline Stage: ${STAGE_STATUS}"
          if [ "${STAGE_STATUS}" = "FAILURE" ] || [ "${STAGE_STATUS}" = "ABORTED" ]; then
            echo "ERROR: stage reporto ${STAGE_STATUS} — no promover a prod."
            exit 1
          fi
          echo "✓ Stage verificado (${STAGE_STATUS}). Continuando con deploy a prod."
        '''
      }
    }

    stage('Tests & Build') {
      steps {
        sh '''
          set -e
          chmod +x ./gradlew
          ./gradlew test bootJar -x :tests:e2e:test --no-daemon --console=plain --warning-mode=none
          find services -path '*/build/libs/*.jar' ! -name '*-plain.jar' -printf '%p (%s bytes)\\n'
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
        }
      }
    }

    stage('Build images') {
      steps {
        sh '''
          set -e
          chmod +x infra/docker/build-all.sh
          TAG=${IMAGE_TAG} bash infra/docker/build-all.sh
        '''
      }
    }

    stage('Deploy to circleguard-prod') {
      steps {
        sh '''
          set -e
          kubectl apply -f infra/k8s/namespaces.yaml
          bash infra/k8s/security/gen-tls-secret.sh ${K8S_NS}
          kubectl apply -k infra/k8s/prod
          kubectl apply -k infra/k8s/security -n ${K8S_NS}
          kubectl -n ${K8S_NS} rollout status deployment --timeout=300s
        '''
      }
    }

    stage('E2E tests prod') {
      steps {
        sh '''
          set -e
          # Wait for gateway to be healthy (max 120 seconds)
          echo "Waiting for gateway to be healthy at ${GATEWAY_URL}/actuator/health..."
          for i in $(seq 1 60); do
            if curl -f -s --max-time 5 ${GATEWAY_URL}/actuator/health > /dev/null 2>&1; then
              echo "Gateway healthy after ${i} checks"
              break
            fi
            if [ $i -eq 60 ]; then
              echo "Gateway did not respond after 60 attempts. Trying E2E anyway..."
              break
            fi
            [ $((i % 10)) -eq 0 ] && echo "Still waiting... (attempt ${i}/60)"
            sleep 3
          done
          ./gradlew :tests:e2e:test -PrunE2E=true \
            -DgatewayUrl=${GATEWAY_URL} \
            -DauthUrl=${AUTH_URL} \
            -DdashboardUrl=${DASHBOARD_URL} \
            --no-daemon --console=plain --warning-mode=none
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'tests/e2e/build/test-results/test/*.xml'
        }
      }
    }

    stage('Generate Release Notes') {
      steps {
        sh '''
          set -e
          mkdir -p build/release
          chmod +x pipelines/semver.sh
          # Version semantica calculada a partir de los commits (Conventional Commits).
          RELEASE_VERSION=$(bash pipelines/semver.sh)
          echo ${RELEASE_VERSION} > build/release/VERSION
          echo "Nueva version semantica: ${RELEASE_VERSION}"

          PREV_TAG=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || true)
          if [ -z "${PREV_TAG}" ]; then
            RANGE_DESC="(historia completa hasta HEAD)"
            RANGE="HEAD"
          else
            RANGE_DESC="(desde ${PREV_TAG} hasta HEAD)"
            RANGE="${PREV_TAG}..HEAD"
          fi

          # Commits directos en master (los auto-promote merges que integran cada ciclo)
          DIRECT_CHANGES=$(git log ${RANGE} --first-parent \
            --pretty=format:'- %h %s (%ad)' --date=short 2>/dev/null || true)
          # Commits individuales feat/fix dentro del rango
          DETAIL_CHANGES=$(git log ${RANGE} --no-merges \
            --pretty=format:'  - %h %s' 2>/dev/null || true)
          # Si el rango no arroja nada (tag == HEAD al primer run), mostrar ultimos 10 commits
          if [ -z "${DIRECT_CHANGES}" ] && [ -z "${DETAIL_CHANGES}" ]; then
            DIRECT_CHANGES=$(git log -10 --first-parent \
              --pretty=format:'- %h %s (%ad)' --date=short 2>/dev/null || true)
          fi
          COMMIT_COUNT=$(git log ${RANGE} --oneline 2>/dev/null | wc -l | tr -d ' ')

          {
            echo "# Release ${RELEASE_VERSION}"
            echo ""
            echo "| Campo | Valor |"
            echo "|-------|-------|"
            echo "| Fecha | $(date -u +'%Y-%m-%d %H:%M:%S UTC') |"
            echo "| Build | #${BUILD_NUMBER} |"
            echo "| Commit | $(git rev-parse --short HEAD) |"
            echo "| Rama | master |"
            echo "| Ambiente | circleguard-prod |"
            echo "| Commits en release | ${COMMIT_COUNT} |"
            echo ""
            echo "## Imagenes desplegadas"
            for s in auth identity gateway promotion notification dashboard; do
              echo "- circleguard/${s}:prod"
            done
            echo ""
            echo "## Cambios ${RANGE_DESC}"
            echo ""
            if [ -n "${DIRECT_CHANGES}" ]; then
              echo "${DIRECT_CHANGES}"
            fi
            if [ -n "${DETAIL_CHANGES}" ]; then
              echo ""
              echo "${DETAIL_CHANGES}"
            fi
            echo ""
            echo ""
            echo "## Verificacion automatica"
            echo "- [x] Tests unitarios + integracion verdes"
            echo "- [x] Build de 6 imagenes Docker exitoso"
            echo "- [x] Deploy a circleguard-prod sin errores"
            echo "- [x] Suite E2E (REST Assured) verde"
          } > build/release/RELEASE-NOTES.md

          echo "----- RELEASE NOTES -----"
          cat build/release/RELEASE-NOTES.md
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'build/release/*', fingerprint: true, allowEmptyArchive: true
        }
      }
    }

    stage('Publish release') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-pat',
                                          usernameVariable: 'GH_USER',
                                          passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set -e
            RELEASE_VERSION=$(cat build/release/VERSION)
            git config user.email "jenkins@circleguard.local"
            git config user.name  "Jenkins CI"
            git tag -d ${RELEASE_VERSION} 2>/dev/null || true
            git tag -a ${RELEASE_VERSION} -m "Release ${RELEASE_VERSION} desde build #${BUILD_NUMBER}"
            git push https://${GH_USER}:${GH_TOKEN}@${GIT_REPO_URL} ${RELEASE_VERSION} || \
              echo "WARN: no se pudo publicar el tag (posiblemente ya existia en remoto)"

            REPO_API=$(echo ${GIT_REPO_URL} | sed -E 's#^github.com/##; s#\\.git$##')
            BODY_JSON=$(python3 -c 'import json,sys;print(json.dumps(open("build/release/RELEASE-NOTES.md").read()))')
            cat > /tmp/release-payload.json <<EOF
{"tag_name":"${RELEASE_VERSION}","name":"${RELEASE_VERSION}","body":${BODY_JSON},"draft":false,"prerelease":false}
EOF
            HTTP=$(curl -sS -o /tmp/release-resp.json -w "%{http_code}" \
              -X POST \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "X-GitHub-Api-Version: 2022-11-28" \
              https://api.github.com/repos/${REPO_API}/releases \
              -d @/tmp/release-payload.json)
            echo "GitHub releases API -> HTTP ${HTTP}"
            if [ "${HTTP}" = "201" ]; then
              echo "GitHub Release publicado."
            elif [ "${HTTP}" = "422" ]; then
              echo "Release ya existia, ok."
            else
              echo "ERROR publicando release:"; cat /tmp/release-resp.json; exit 1
            fi
          '''
        }
      }
    }
  }

  post {
    always {
      // Escala prod a 0 replicas para liberar RAM en local.
      // En un entorno real de prod esto NO se haria.
      sh 'kubectl -n ${K8S_NS} scale deployment --all --replicas=0 2>/dev/null || true'
    }
    success {
      echo "Pipeline MASTER OK -- release publicada. Prod escalado a 0 para ahorrar recursos locales."
    }
    failure {
      sh 'kubectl -n ${K8S_NS} get pods || true'
      sh 'kubectl -n ${K8S_NS} get events --sort-by=.lastTimestamp | tail -n 30 || true'
      sh 'bash pipelines/notify.sh "FALLO pipeline MASTER #${BUILD_NUMBER}" "El build de produccion fallo. Revisa: ${BUILD_URL}" || true'
    }
  }
}
